{
  "name": "bhagya-score",
  "version": "1.0.0",
  "description": "AstroLokal Bhagya Score — mobile webview + API, Postgres-backed, K8s-ready.",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "generate": "node dist/jobs/generateDailyContent.js",
    "generate:dev": "tsx src/jobs/generateDailyContent.ts",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down 1",
    "migrate:create": "node-pg-migrate create --migration-file-language js",
    "migrate:redo": "node-pg-migrate down 1 && node-pg-migrate up"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
