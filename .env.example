# Copy to .env for local runs outside docker-compose.
# Any Postgres-compliant database works — just point DATABASE_URL at it.
DATABASE_URL=postgres://bhagya:bhagya@localhost:5432/bhagya

# HTTP server
# 3000 matches the Lokal Devtron chart (ContainerPort / liveness / readiness all use 3000).
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Connection pool (per pod). Keep modest so N pods x poolMax stays under the DB max.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# App
DEFAULT_LANG=en
SHUTDOWN_TIMEOUT_MS=10000

# --- Daily content generation (Gemini) ---
# API key from Google AI Studio. Required only for the generator (job/scheduler/internal route);
# the web server itself boots fine without it and serves whatever is already in the DB.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=60000

# Nightly generation behaviour
# Turn this on to let the web pods self-schedule the nightly job (no extra CronJob needed).
CONTENT_SCHEDULER_ENABLED=true  # nightly refresh runs by itself when GEMINI_API_KEY is set
CONTENT_RUN_HOUR_IST=1          # 01:00 IST
CONTENT_GENERATE_OFFSET_DAYS=0  # 01:00 IST run generates the same day; goes live at the 6 AM cutover
CONTENT_LANGS=en                # comma-separated, e.g. en,hi

# Guards POST /internal/generate-content. Empty => internal routes are disabled (404).
INTERNAL_TOKEN=
